# Optional; default database is in this repository's ignored backend/local directory.
# Use an absolute path outside cloud-sync folders if relocating it.
# DATABASE_URL=sqlite:////absolute/path/to/elections.db

# Docker Compose local production (copy to .env; never commit credentials).
APP_UID=501
APP_GID=20
LOCAL_PORT=8080
REFRESH_TIMEZONE=Asia/Kolkata
REFRESH_INTERVAL_HOURS=6
# File contains only the remotely managed Cloudflare Tunnel token.
# Keep missing until public activation is authorized; local profiles do not need it.
CLOUDFLARE_TOKEN_FILE=./.production/secrets/tunnel-token
