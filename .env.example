# Optional; default database is in this repository's ignored backend/local directory.
# Use an absolute path outside cloud-sync folders if relocating it.
# DATABASE_URL=sqlite:////absolute/path/to/elections.db

# Docker Compose local production (copy to .env; never commit credentials).
APP_UID=501
APP_GID=20
# These are Linux container identities, also valid under Docker Desktop on Windows.
# Keep them consistent with the existing volume; do not substitute a Windows SID.
LOCAL_PORT=8080
REFRESH_TIMEZONE=Asia/Kolkata
REFRESH_INTERVAL_HOURS=6
# File contains only the remotely managed Cloudflare Tunnel token.
# Keep missing until public activation is authorized; local profiles do not need it.
CLOUDFLARE_TOKEN_FILE=./.production/secrets/tunnel-token

# Optional New Relic backend monitoring; see docs/newrelic-monitoring.md.
# Store the ingest license key in .production/secrets/newrelic-license-key.
# NEW_RELIC_APP_NAME=Arizona Election Explorer (Production)
# NEW_RELIC_HOST=collector.newrelic.com
# Windows: enable the monitoring override for ordinary Compose commands.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=compose.yaml;compose.newrelic.yaml
