{
	auto_https off
	admin off
	# Runtime logs only; no per-request access logger. Drop request data even
	# when the reverse proxy attaches it to a runtime error.
	log {
		output stdout
		sampling {
			interval 5m
			first 1
			thereafter 1000
		}
		format append {
			service frontend
			event caddy_runtime
			wrap filter {
				wrap json {
					level_key severity
					time_key timestamp
					time_format rfc3339_nano
				}
				fields {
					request delete
					resp_headers delete
				}
			}
		}
	}
	grace_period 30s
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	# Cloudflare terminates visitor TLS; the tunnel's Docker origin stays HTTP.
	@public_http {
		host azelections.app
		header X-Forwarded-Proto http
	}
	redir @public_http https://azelections.app{uri} 308
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Preserve backend browser-cache policies; default errors to no-store.
	handle /api/* {
		header {
			?Cache-Control "no-store, no-transform"
			defer
		}
		# Caddy flushes text/event-stream immediately without response buffering.
		# Keep its default cancellation behavior when a browser disconnects.
		reverse_proxy backend:8000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
